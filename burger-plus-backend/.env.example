# ==================================================
# YEREL GELİŞTİRME (bilgisayarında Docker PostgreSQL)
# ==================================================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=burger_plus
PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=24h
SUPER_ADMIN_JWT_TTL=8h
# Başvuru IP'lerini geri döndürülemez özetlemek için JWT'den ayrı bir sır kullanın.
BASVURU_IP_TUZU=replace-with-another-at-least-32-random-characters
MASA_TOKEN_SECRET=replace-with-a-stable-at-least-32-character-secret
# Öneri görüntülenme/tıklama/satın alma referanslarını imzalamak için ayrı sır.
ONERI_REFERANS_SECRET=replace-with-a-different-at-least-32-character-secret
MFA_ENCRYPTION_KEY=replace-with-64-character-hex-key
ODEME_SIMULASYON_AKTIF=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Veritabaninda hic isletme yoksa ilk gercek isletmeyi olusturmak icin zorunludur.
# Sonraki isletmeler Super Admin kurulum akisi ile eklenir.
ILK_ISLETME_SLUG=isletmenizin-url-adi
ILK_ISLETME_ADI=Isletmenizin resmi adi
ILK_ISLETME_KONSEPTI=burger

# Müşteri/QR menü içeriklerini kayıt sırasında İngilizceye çevirir.
# Anahtar yalnızca backend ortamında tutulmalıdır.
# GEMINI_API_KEY=...
# GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_MENU_MODEL=gemini-3.1-flash-lite
# GEMINI_TRANSLATION_BACKFILL_ON_START=false

# ==================================================
# YAYIN (Supabase + Render)
# Yukarıdakiler yerine tek satır yeterli:
# ==================================================
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# JWT_SECRET=replace-with-at-least-32-random-characters
# JWT_ACCESS_TTL=24h
# SUPER_ADMIN_JWT_TTL=8h
# BASVURU_IP_TUZU=replace-with-another-at-least-32-random-characters
# MASA_TOKEN_SECRET=replace-with-a-stable-at-least-32-character-secret
# ONERI_REFERANS_SECRET=replace-with-a-different-at-least-32-character-secret
# MFA_ENCRYPTION_KEY=replace-with-64-character-hex-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=burger-plus
#
# SSL'siz bir PostgreSQL kullanıyorsan:
# PGSSL=false

# İyzico Checkout Form (yalnızca backend/Render ortam değişkenleri)
# IYZICO_API_KEY=your-iyzico-api-key
# IYZICO_SECRET_KEY=your-iyzico-secret-key
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Müşteriden TCKN/adres istemeyen nihai tüketici ödeme akışı için
# işletmenize ait hukuken geçerli varsayılan fatura bilgilerini kullanın:
# IYZICO_DEFAULT_IDENTITY_NUMBER=your-legally-valid-identity-number
# IYZICO_DEFAULT_ADDRESS=your-registered-business-address
# IYZICO_DEFAULT_CITY=Istanbul
# IYZICO_DEFAULT_ZIP_CODE=34000
# PUBLIC_BACKEND_URL=https://your-backend.example.com
# FRONTEND_URL=https://your-frontend.example.com
# CORS_ORIGINS=https://your-frontend.example.com
# ODEME_SIMULASYON_AKTIF=false
# ILK_ISLETME_SLUG=isletmenizin-url-adi
# ILK_ISLETME_ADI=Isletmenizin resmi adi
# ILK_ISLETME_KONSEPTI=burger

# İlk platform yöneticisi. Yalnızca super_adminler tablosu boşken kullanılır.
# Şifre 12-72 karakter olmalıdır; ilk girişte 2FA kurulumu zorunludur.
SUPER_ADMIN_EMAIL=platform@example.com
SUPER_ADMIN_SIFRE=degistirilecek-guclu-bir-sifre
SUPER_ADMIN_AD=Platform Yöneticisi
